[Unit]
Description=monitord - systemd health metrics collector
Documentation=https://github.com/cooperlees/monitord
After=dbus.socket
Requires=dbus.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/monitord -c /etc/monitord.conf
# Run as a dedicated user for least privilege
# Create with: useradd --system --no-create-home monitord
User=monitord
Group=monitord
RuntimeDirectory=monitord
RuntimeDirectoryMode=0750
# Only needed if you collect from machines/containers (see README Permissions):
# CAP_SYS_PTRACE reaches machines via /proc/<leader_pid>/root. CAP_SYS_ADMIN
# joins their PID namespace and is only needed with varlink enabled for
# machines; for D-Bus machine collection CAP_SYS_PTRACE alone is enough.
#AmbientCapabilities=CAP_SYS_PTRACE CAP_SYS_ADMIN
#CapabilityBoundingSet=CAP_SYS_PTRACE CAP_SYS_ADMIN

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
